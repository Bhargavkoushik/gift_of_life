PORT=5000
DB_HOST=localhost
DB_PORT=5433
DB_NAME=gift_of_life
DB_USER=postgres
DB_PASSWORD=your_password_here
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Password Reset Life (Minutes)
PASSWORD_RESET_TOKEN_MINUTES=30

# Notification Providers ('console' or configured provider integrations)
MAIL_PROVIDER=console
MAIL_FROM=noreply@giftoflife.org
SMS_PROVIDER=console

# SMTP Configuration (required if MAIL_PROVIDER=smtp)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email_here@gmail.com
MAIL_PASSWORD=your_app_password_here

# Frontend base URL for link assembly
FRONTEND_URL=http://localhost:5173